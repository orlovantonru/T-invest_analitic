# Copy to app/.env. This file (.env) is gitignored.

# --- local dev (npm run dev) ---
# READ-ONLY T-Invest token. Create at:
#   T-Bank app / web -> Инвестиции -> Настройки -> Токены Т-Invest API  (доступ «только чтение»)
TINVEST_TOKEN=
# Port the local proxy listens on (frontend expects 8787 via Vite proxy).
PROXY_PORT=8787

# --- docker compose deploy (see DEPLOY.md) ---
# Domain Caddy serves + gets a Let's Encrypt cert for. Required for `docker compose up`.
# APP_DOMAIN=portfolio.example.com
