# Copy to app/.env and paste a READ-ONLY T-Invest token.
# Create one at: T-Bank app / web -> Инвестиции -> Настройки -> Токены Т-Invest API
# Give it "только чтение" (read-only) access. This file (.env) is gitignored.
TINVEST_TOKEN=

# Port the local proxy listens on (frontend expects 8787 via Vite proxy).
PROXY_PORT=8787
