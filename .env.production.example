# Copy to .env.production on the VPS (gitignored). Used by docker-compose `web`.

# READ-ONLY T-Invest token (T-Bank -> Инвестиции -> Настройки -> Токены Т-Invest API).
TINVEST_TOKEN=

# Session cookie signing key.  Generate:  openssl rand -hex 32
SESSION_SECRET=

# Login password hash.  Generate:  node scripts/hash-password.mjs '<пароль>'
# (user name is "admin"). For multiple users use APP_USERS instead:
#   APP_USERS={"alice":"<hash>","bob":"<hash>"}
APP_PASSWORD_HASH=

PROXY_PORT=8787
PROXY_HOST=0.0.0.0
NODE_ENV=production
